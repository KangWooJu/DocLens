# Copy to .env (git-ignored) and fill in real values.
# Spring modules read it through spring.config.import; IntelliJ run configuration variables override it.
# External service keys are filled in by the user, never committed.

# Collector (local values match compose.yaml; COLLECTOR_CONTACT is a public contact address for the User-Agent, required before any external request)
COLLECTOR_DB_URL=
COLLECTOR_CONTACT=
DOCLENS_S3_ENDPOINT=
DOCLENS_S3_BUCKET=
DOCLENS_S3_ACCESS_KEY=
DOCLENS_S3_SECRET_KEY=
DOCLENS_PIPELINE_OBJECT_STORE=
