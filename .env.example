# Copy to .env (git-ignored) and fill in real values.
# Spring modules read it through spring.config.import; IntelliJ run configuration variables override it.
# External service keys are filled in by the user, never committed.

# Collector (local values match compose.yaml; COLLECTOR_CONTACT is a public contact address for the User-Agent, required before any external request)
COLLECTOR_DB_URL=
COLLECTOR_CONTACT=
DOCLENS_S3_ENDPOINT=
DOCLENS_S3_BUCKET=
DOCLENS_S3_ACCESS_KEY=
DOCLENS_S3_SECRET_KEY=
DOCLENS_OBJECT_STORE=

# Internal API callers (collector-api, pipeline): <caller>:<sha256 hex of the token>, comma separated, e.g. scheduler:...,operator:...
DOCLENS_CALLER_TOKENS=
# Operator token for GET /internal/v1/publications/latest lives in your shell, not here: export DOCLENS_OPERATOR_TOKEN=...

# Scheduler: bearer token (raw value) and the approved processing config hash from the pipeline startup log
DOCLENS_SCHEDULER_TOKEN=
DOCLENS_SCHEDULER_PROCESSING_CONFIG_HASH=
# Optional, an empty value overrides the default, so uncomment only to change it
# (compose sets the URLs and the request file; the defaults suit an IDE run)
# DOCLENS_SCHEDULER_COLLECTOR_URL=
# DOCLENS_SCHEDULER_PIPELINE_URL=
# DOCLENS_SCHEDULER_REQUEST_FILE=
# DOCLENS_SCHEDULER_COLLECT_ENABLED=
# DOCLENS_SCHEDULER_COLLECT_TIME=
